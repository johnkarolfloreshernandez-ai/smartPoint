<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRegistro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="270dp"
            android:layout_height="151dp"
            app:srcCompat="@drawable/foto_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>

        <EditText
            android:id="@+id/edtUsuarioRegistro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="#F1F5F9"
            android:hint="Usuario"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="#F1F5F9"
            android:hint="Correo Electrónico"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtTelefonoRegistro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="#F1F5F9"
            android:hint="Teléfono"
            android:inputType="phone"
            android:maxLength="15"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtPasswordRegistro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="#F1F5F9"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtConfirmarPasswordRegistro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="#F1F5F9"
            android:hint="Confirmar Contraseña"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1E88E5"
            android:text="Crear cuenta"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVolverLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="8dp"
            android:text="¿Ya tienes cuenta? Inicia sesión"
            android:textColor="#1E88E5"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>